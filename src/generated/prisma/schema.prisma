generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id     String @id @default(cuid())
  userId String
  phone  String

  cakeDescription String
  price           Int
  quantity        Int    @default(1)

  deliveryType    String
  deliveryAddress String?

  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model CakeRequest {
  id String @id @default(cuid())

  customerName String
  phone        String
  email        String

  cakeSize String
  flavor   String
  design   String
  message  String?

  requiredDate  String
  preferredTime String

  fulfillment     String
  deliveryAddress String?

  deliveryChargeApplicable Boolean @default(false)

  eggless    Boolean @default(true)
  vegetarian Boolean @default(true)

  status String @default("NEW")

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatConversation ChatConversation?

  @@index([userId])
  @@index([status])
  @@index([requiredDate])
}

model ChatConversation {
  id                 String    @id @default(cuid())
  cakeRequestId      String    @unique
  userId             String
  customerLastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cakeRequest CakeRequest   @relation(fields: [cakeRequestId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([userId])
  @@index([cakeRequestId])
}

model ChatMessage {
  id             String @id @default(cuid())
  conversationId String

  senderType   String
  senderUserId String?
  message      String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}
